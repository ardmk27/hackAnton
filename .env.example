# Salin file ini menjadi .env lalu isi. JANGAN commit .env ke GitHub.

# --- Database (default Laragon) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kader_cukup_foto
DB_USER=root
DB_PASS=

# --- OCR/AI ---
# gemini = baca foto dengan Gemini | mock = data contoh sintetis (mode demo)
OCR_MODE=mock
GEMINI_API_KEY=
# Nama model Gemini yang mendukung input gambar + JSON. Ganti jika perlu.
GEMINI_MODEL=gemini-2.5-flash

# --- Aplikasi ---
# Batas ukuran foto (MB)
MAX_UPLOAD_MB=8
# Folder foto. Disarankan di LUAR web root pada penggunaan nyata.
# Kosongkan untuk memakai storage/uploads di dalam proyek.
UPLOAD_DIR=
# true hanya saat pengembangan
APP_DEBUG=false

# --- Opsional (versi 2) ---
# true = baca foto DUA kali dan tandai sel yang hasilnya berbeda (biaya API 2x)
OCR_TWO_PASS=false
# true = tampilkan tombol "Muat data demo" di dashboard Posyandu yang masih kosong
DEMO_SEED_ENABLED=false
